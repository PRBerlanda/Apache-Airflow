# Copy to .env and load with:  set -a; source .env; set +a
AIRFLOW_HOME=$PWD/.airflow
AIRFLOW__CORE__DAGS_FOLDER=$PWD/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Mock Twitter API used by the course (fictitious tweets, no credentials)
AIRFLOW_CONN_TWITTER_DEFAULT=http://labdados.com
# spark-submit runs locally
AIRFLOW_CONN_SPARK_DEFAULT='{"conn_type": "spark", "host": "local"}'
# Spark that ships with the pyspark package (or a downloaded spark-4.2.0-bin-hadoop3 folder)
SPARK_HOME=$(python -c 'import os, pyspark; print(os.path.dirname(pyspark.__file__))')
# Root of the data lake (default: this folder, so datalake/ is used)
AIRFLOW_DATA_DIR=$PWD
