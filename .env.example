# Copy to .env and load with:  set -a; source .env; set +a
AIRFLOW_HOME=$PWD/.airflow
AIRFLOW__CORE__DAGS_FOLDER=$PWD/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=2
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost/airflow_db
AIRFLOW__CELERY__BROKER_URL=redis://localhost:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@localhost/airflow_db
AIRFLOW__CELERY__WORKER_CONCURRENCY=3
# Local lab only: every user is admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True
# Output folder for the DAGs (default: ~/airflow-data/celery)
AIRFLOW_DATA_DIR=$PWD/output
