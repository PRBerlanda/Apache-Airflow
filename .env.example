# Copy to .env and load with:  set -a; source .env; set +a
AIRFLOW_HOME=$PWD/.airflow
AIRFLOW__CORE__DAGS_FOLDER=$PWD/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Output folder for the DAGs (default: ~/airflow-data/basics)
AIRFLOW_DATA_DIR=$PWD/output
# Free key from https://www.visualcrossing.com/weather-api (read as Airflow Variable visual_crossing_key)
AIRFLOW_VAR_VISUAL_CROSSING_KEY=your-key-here
